{
  "name": "vestra/laravel-sep",
  "description": "A production-oriented Laravel package for the direct SEP (Saman Electronic Payment) Internet Payment Gateway, based on SEP technical document v3.6.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.8",
    "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0",
    "nunomaduro/larastan": "^2.9|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Vestra\\Sep\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Vestra\\Sep\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vestra\\Sep\\SepServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
